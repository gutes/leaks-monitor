# Copiá este archivo a .env y ajustá. NUNCA commitees el .env con valores reales.
# Todos los valores acá son placeholders inertes.

# ---------------------------------------------------------------------------
# Persistencia
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# RUTAS — comentadas a propósito.
#
# La imagen de Docker ya las fija a las suyas (/data, /app/…). Si se definen
# acá, `env_file` las mete en el contenedor y le pisan las absolutas por rutas
# del host: el proceso arranca contra una base vacía y muere con
# "no such table: watchlist_entries", en bucle.
#
# Descomentalas SOLO para correr sin Docker, desde el checkout.
# ---------------------------------------------------------------------------
# LEAKS_DATABASE_URL=sqlite:///./data/leaks.db
# Migraciones; en Docker apuntan a /app.
# LEAKS_ALEMBIC_DIR=./alembic
# LEAKS_ALEMBIC_INI=./alembic.ini

# ---------------------------------------------------------------------------
# PII — fail-closed. Con STORE_PII=false (default) el pipeline persiste SOLO
# metadata no sensible. Si lo ponés en true, LEAKS_PII_ENCRYPTION_KEY es
# obligatoria o el proceso se niega a arrancar.
# Generar la clave con:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
LEAKS_STORE_PII=false
LEAKS_PII_ENCRYPTION_KEY=
LEAKS_PII_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# HTTP — User-Agents por feed.
# El default NO es atribuible: identifica a la herramienta, no al operador ni
# al alcance del monitoreo. Ver docs/feeds.md.
# ---------------------------------------------------------------------------
LEAKS_HTTP_USER_AGENT=leaks-monitor/0.1
LEAKS_HTTP_TIMEOUT_SECONDS=30
LEAKS_HTTP_MAX_RETRIES=3
LEAKS_HTTP_BACKOFF_BASE_SECONDS=2.0
LEAKS_HTTP_RATE_LIMIT_DELAY_SECONDS=1.0

# ---------------------------------------------------------------------------
# Feeds
# Lista separada por comas para forzar un subconjunto. Vacío = los habilitados
# por defecto en el registro (src/leaks/adapters/registry.py).
# ---------------------------------------------------------------------------
LEAKS_ENABLED_FEEDS=

# Hudson Rock consulta dominio por dominio contra un proveedor extranjero.
# NO lee la watchlist a propósito: cada dominio acá es una decisión explícita.
# Vacío = no sale un solo request, aunque la fuente esté habilitada.
LEAKS_HUDSONROCK_DOMAINS=

# Además de los de arriba, recorrer la watchlist por lotes rotativos.
# Apagado por defecto: cada consulta le revela al proveedor qué organismo estás
# vigilando, así que activarlo es una decisión, no un default. Con ~2 s por
# dominio, 25 por corrida cubre 173 dominios en una semana sin publicar la
# watchlist entera de una ni castigar un endpoint gratuito.
LEAKS_HUDSONROCK_FROM_WATCHLIST=false
LEAKS_HUDSONROCK_MAX_PER_RUN=25

# Foros MyBB (sindicación Atom pública). Son fuentes con PII: no corren salvo
# que se habiliten las fuentes con PII desde la UI. Rotan de dominio: se prueba
# en orden y gana el primero que responda.
LEAKS_DARKFORUMS_BASE_URLS=https://darkforums.as,https://darkforums.ru
# Verificado el 2026-09-10: bf.st sirve el Atom. Los anteriores, incautados.
LEAKS_BREACHFORUMS_BASE_URLS=https://bf.st

# Subforos a consultar además del índice global (ids separados por coma).
# Cada uno trae SUS últimos 50 threads, así que suman ventana: medido el
# 2026-09-01, el índice global cubría 20,6 h y un subforo activo 1,8 días.
# Los ids se sacan A MANO del navegador: el HTML del foro está detrás de un
# desafío JS y el pipeline no lo toca — pasarlo sería evadir un control.
LEAKS_DARKFORUMS_FIDS=
LEAKS_BREACHFORUMS_FIDS=

# ---------------------------------------------------------------------------
# Alertas
# Se avisa de los hallazgos NUEVOS que llegan al umbral. Un hallazgo se alerta
# una sola vez; si el envío falla queda pendiente y se reintenta en la próxima
# corrida. Las alertas llevan SOLO metadata, nunca PII.
# Sin canales configurados, no se manda nada (no es un error).
# ---------------------------------------------------------------------------
LEAKS_ALERT_MIN_SEVERITY=high
LEAKS_ALERT_MAX_PER_RUN=50
# No avisar de eventos más viejos que esto. Evita el chubasco de alertas cuando
# una fuente importa su histórico: son cosas que recién conocemos, no que
# recién pasaron.
LEAKS_ALERT_MAX_AGE_DAYS=30

# Horas sin una corrida exitosa antes de avisar que una fuente se calló.
# 26 y no 24: una corrida diaria que sale un rato tarde no es una falla.
# 0 apaga el watchdog.
LEAKS_WATCHDOG_MAX_SILENCE_HOURS=26

# Si la corrida agendada se salteó porque la máquina estaba suspendida, correr
# al despertar en vez de esperar a la próxima. En un portátil que duerme de
# noche, sin esto la corrida de las 03:00 no ocurre nunca.
LEAKS_SCHEDULER_CATCHUP=true

# Umbral para clasificar un hallazgo como reciente o histórico en la UI.
LEAKS_FRESHNESS_DAYS=30

# Webhook genérico: sirve para Slack, Discord, n8n o uno propio.
LEAKS_ALERT_WEBHOOK_URL=

# Telegram: hacen falta los dos valores.
LEAKS_ALERT_TELEGRAM_TOKEN=
LEAKS_ALERT_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# IP de salida (control de OPSEC)
# Si el tráfico sale desde un país bloqueado, NO se consulta ninguna fuente y
# la UI queda bloqueada. Fail-closed: si no se puede determinar el país,
# también bloquea. No hay override desde la interfaz.
# ---------------------------------------------------------------------------
LEAKS_EGRESS_CHECK_ENABLED=true
LEAKS_EGRESS_BLOCKED_COUNTRIES=AR
LEAKS_EGRESS_BLOCK_ON_UNKNOWN=true
LEAKS_EGRESS_CACHE_SECONDS=300

# ---------------------------------------------------------------------------
# Relevancia argentina
# La watchlist del YAML es la SEMILLA: se importa a la base la primera vez y
# a partir de ahí se gestiona desde la UI.
# ---------------------------------------------------------------------------
# LEAKS_WATCHLIST_PATH=./data/watchlist.yaml

# ---------------------------------------------------------------------------
# Scheduler — hora local del run diario en modo `leaks schedule`.
# ---------------------------------------------------------------------------
LEAKS_DAILY_RUN_AT=03:00
# Correr una vez al arrancar `leaks schedule`, sin esperar a la hora.
LEAKS_RUN_ON_START=true

# ---------------------------------------------------------------------------
# Consola de actividad — días que se conserva la bitácora del pipeline.
# ---------------------------------------------------------------------------
LEAKS_EVENT_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# API / frontend (solo lectura, sin auth: prototipo pensado para localhost)
# ---------------------------------------------------------------------------
# Ruta de los estáticos; en Docker se apunta a /app/frontend.
# LEAKS_FRONTEND_DIR=./frontend
# LEAKS_API_HOST: lo fija la imagen en 0.0.0.0. Definirlo acá deja la API
# escuchando solo en el loopback DEL CONTENEDOR y el puerto publicado no llega.
# La exposición real se controla en `ports:` del docker-compose.yml.
# LEAKS_API_HOST=127.0.0.1
LEAKS_API_PORT=8000
LEAKS_API_MAX_PAGE_SIZE=200
# Permite editar watchlist y reglas desde la UI. Ponelo en false en un
# despliegue compartido. No afecta al control de IP de salida, que no se puede
# desactivar por ninguna vía de la API.
LEAKS_ALLOW_RULE_EDITING=true

# Zona horaria de los contenedores. Sin esto corren en UTC y
# LEAKS_DAILY_RUN_AT —documentado como "hora local"— cae corrido: 03:00
# terminaba siendo medianoche argentina. También fija la fecha de los logs.
TZ=America/Argentina/Buenos_Aires

LEAKS_LOG_LEVEL=INFO
