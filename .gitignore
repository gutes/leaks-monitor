# Secretos y config local — NUNCA se commitean (regla no negociable #2)
.env
.env.*
!.env.example

# Watchlists reales — NUNCA se commitean.
#
# Una watchlist dice qué organismos vigila la investigación: publicarla es
# publicar el mapa del trabajo. Al repo va solo `data/examples/`, y el código
# cae ahí cuando estos no existen (ver `config._respaldo_de_ejemplo`).
data/watchlist.yaml
data/watchlist-regional/

# Paquetes de datos. `leaks export-bundle --out /app/data/x.tar.gz` los escribe
# acá para que aterricen en el host, y contienen la base ENTERA: hallazgos,
# watchlist y víctimas regionales. Commitear uno sería peor que commitear la
# watchlist sola.
data/*.tar.gz
data/*.tar.gz.age
data/*.tar.gz.gpg
!data/examples/

# El `.env` operativo que se manda junto al paquete en un traspaso. No lleva
# secretos —la clave del vault se saca a mano— pero sí los dominios de foro y
# los fids que se están vigilando, que es config operativa y no va al repo.
# `.env` a secas no lo cubre: el patrón matchea el nombre exacto, no el sufijo.
data/*.env

# El prompt fundacional: es del líder técnico y enumera los organismos a
# vigilar, o sea la semilla de la watchlist. Se queda en el disco.
bootstrap-prompt.md

# Base de datos y datos derivados del run
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# Entorno Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
uv.lock

# Configuración local de la herramienta (permisos de esta máquina)
.claude/settings.local.json

# Herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Sistema
.DS_Store
